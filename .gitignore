# Virtual environment — never commit this
.venv/
.venv-cluster/

# Private correspondence — supervisor/collaborator emails, feedback docs, briefings.
# NOT deleted (repo policy is keep-and-label); retained locally, just not published
# on a public repo. These are coordination material, never results evidence.
private/

# Compiled CUDA kernel binaries — arch-specific (sm_86) and rebuildable via the
# nvcc one-liners in README.md. Sources in inference/kernels/*.cu are the artifact.
inference/kernels/fused_block1
inference/kernels/fused_block2
inference/kernels/fused_block3
inference/kernels/fused_block3_fp16
inference/kernels/fused_block3_naive
inference/kernels/fused_block4
inference/kernels/fused_block4_fp16
inference/kernels/fused_pipeline

# Local experiment checkpoint trees (~131 MB of .pth). Their result JSONs under
# benchmarks/results/ are the claim surface, not the weights.
model/ablation_ladder/
model/baselines_neural/
model/cstar_bounded/
model/hpo/
model/hpo_smoke/
model/imbalance_loss/
model/multirun/
