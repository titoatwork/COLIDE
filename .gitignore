model/sealed_test/
model/stratified_batch/
model/teachers_kd/
model/teachers_kd_neural/
model/toniot_final/

# Local run logs / thermal guards (not claim artifacts)
logs/*
!logs/README.md
*.bak
*.bak_before_review
*:Zone.Identifier

# Dataset — too large for git
data/raw/
data/processed/
data/splits/

# Model weights — exported separately
model/weights/
# Note: model/*.pth is NOT ignored. Champion
# (model/best_model_botiot_twostage.pth) is tracked. New trees such as
# model/toniot_corrected/*.pth can be added normally (or git add -f if
# a future ignore rule blocks them).

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Jupyter checkpoints
.ipynb_checkpoints/

# Benchmark raw results — keep plots, not raw data
# Exceptions: claim-hygiene / remediation artifacts that must stay tracked.
benchmarks/results/*
!benchmarks/results/toniot_corrected/
!benchmarks/results/toniot_corrected/**
!benchmarks/results/block3_parity_gate.json
!benchmarks/results/toniot_clean_comparison.json
!benchmarks/results/toniot_clean_comparison.INVALIDATED.json
!benchmarks/results/toniot_clean_retrain.json
!benchmarks/results/toniot_clean_retrain.INVALIDATED.json
# Claim-eligible sources cited by README / RESULTS_INDEX / CLAIM_MAP. These back
# the principal sealed-test result and the CUDA/baseline tables — a reader must be
# able to verify a published number without asking us for a file.
!benchmarks/results/sealed_test/
!benchmarks/results/sealed_test/**
!benchmarks/results/toniot_final/
!benchmarks/results/toniot_final/summary.json
!benchmarks/results/cuda_kernel_stats_rtx3050.json
!benchmarks/results/pytorch_block3_stats_rtx3050.json
!benchmarks/results/rf_baseline_processed.json

