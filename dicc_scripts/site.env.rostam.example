# Rostam (LSU CCT) example — copy to site.env or source before submit:
#   cp dicc_scripts/site.env.rostam.example dicc_scripts/site.env
#
# Partitions from `sinfo` (2026-07): cuda-V100, cuda-A100, DGX-A100, …
# Nvidia GRES required: --gres=gpu:N  (wiki: wiki.rostam.cct.lsu.edu/en/slurm/gpu)
# Account usually not required; omit COLIDE_SBATCH_ACCOUNT if so.

COLIDE_SBATCH_GRES=gpu:1
COLIDE_SBATCH_TIME=02:00:00
COLIDE_SBATCH_CPUS=4
COLIDE_SBATCH_MEM=32G
# Do not set a single global partition when submitting both V100+A100 —
# set COLIDE_PROFILE_PARTITION in each profile (see below) OR submit twice.

# After copy, also edit profiles:
#   profiles/v100.env → COLIDE_PROFILE_PARTITION=cuda-V100
#   profiles/a100.env → COLIDE_PROFILE_PARTITION=cuda-A100
