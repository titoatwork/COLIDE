# Copy to site.env (gitignored optional) or export these in your shell.
# None of these are required if your cluster accepts the generic defaults
# in submit_session.sh (#SBATCH --gres=gpu:1, 4 CPUs, 32G, 2h).

# --- Slurm resource overrides (passed on the sbatch command line) ---
# COLIDE_SBATCH_PARTITION=gpu
# COLIDE_SBATCH_ACCOUNT=myalloc
# COLIDE_SBATCH_QOS=normal
# COLIDE_SBATCH_GRES=gpu:1
# COLIDE_SBATCH_CONSTRAINT=v100
# COLIDE_SBATCH_NODELIST=          # leave empty on portable sites; set only if you must pin nodes
# COLIDE_SBATCH_TIME=02:00:00
# COLIDE_SBATCH_CPUS=4
# COLIDE_SBATCH_MEM=32G
# COLIDE_SBATCH_EXTRA=             # free-form extra flags, space-separated, e.g. --exclusive

# --- Which GPU profiles to submit (comma-separated). Must match profiles/*.env basenames ---
# COLIDE_TARGETS=v100,a100

# --- Setup / compile ---
# COLIDE_COMPILE_TARGETS=sm_70:v100,sm_80:a100
# COLIDE_CUDA_MODULES=cuda/12.1 cuda cuda/11.8
# COLIDE_CONDA_MODULES=miniconda anaconda conda

# --- Optional: pin expected GPU identity per profile via profiles/*.env ---
