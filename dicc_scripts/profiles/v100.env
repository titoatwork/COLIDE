# Portable V100 profile. Values are unconditional so sequential submits do not leak.
COLIDE_GPU_LABEL=v100s
COLIDE_GPU_NAME_RE=V100
COLIDE_GPU_CC=7.0
# 16GB V100s are common; do not require 32GB.
COLIDE_GPU_MIN_MEM=14000
COLIDE_KERNELS_SUBDIR=v100
COLIDE_NVCC_ARCH=sm_70
COLIDE_JOB_SCRIPT=job_benchmark.sh
