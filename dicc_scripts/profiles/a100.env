# Portable A100 profile. Values are unconditional so sequential submits do not leak.
COLIDE_GPU_LABEL=a100
COLIDE_GPU_NAME_RE=A100
COLIDE_GPU_CC=8.0
COLIDE_GPU_MIN_MEM=30000
COLIDE_KERNELS_SUBDIR=a100
COLIDE_NVCC_ARCH=sm_80
COLIDE_JOB_SCRIPT=job_benchmark.sh
# Per-profile Slurm overrides (empty = use submit_session --partition/--gres/…).
# Rostam example: COLIDE_PROFILE_PARTITION=cuda-A100
COLIDE_PROFILE_PARTITION=
COLIDE_PROFILE_CONSTRAINT=
COLIDE_PROFILE_GRES=
